# CloudPulse Environment Configuration Template
# Copy this file to .env for local development

# Application Profiles & Server Ports
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8081
VITE_PORT=5174
VITE_API_BASE_URL=http://localhost:8081/api

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5435
DB_NAME=cloudpulse
DB_USER=cloudpulse_user
DB_PASSWORD=cloudpulse_secure_pass_change_me
DB_DOCKER_PORT=5435

# JWT Authentication
# Must be at least 256-bit (32 bytes) hex or base64 encoded string
JWT_SECRET=4c6f756450756c736553757065725365637265744b6579323032365365637572654b65792121
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Monitoring Engine Thread Pool & Limits
MONITORING_CORE_POOL_SIZE=10
MONITORING_MAX_POOL_SIZE=30
MONITORING_QUEUE_CAPACITY=500
MONITORING_DEFAULT_TIMEOUT_MS=10000
MONITORING_MAX_TIMEOUT_MS=30000
MONITORING_MAX_RESPONSE_BODY_BYTES=1048576

# SSRF Protections
SSRF_PROTECTION_ENABLED=true
SSRF_ALLOW_PRIVATE_IPS=false

# Rate Limiting
AUTH_RATE_LIMIT_PER_MINUTE=15
API_RATE_LIMIT_PER_MINUTE=120



SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=sachgupta209@gmail.com
SPRING_MAIL_PASSWORD=qonzqgbkqgtvuerp
SPRING_MAIL_FROM=sachgupta209@gmail.com

SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_REQUIRED=true


MAILPIT_WEB_PORT=8025
